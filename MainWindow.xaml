<Window x:Class="ES2MD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ES2MD"
        mc:Ignorable="d"
		Background="Beige"
        Title="ES2MD" Height="425" Width="400">
    <Grid>
		<StackPanel Margin="0,25,0,0" HorizontalAlignment="Center">
			<StackPanel Orientation="Horizontal">
				<Button Height="25" Width="25" Margin="5,0" Content="..." Click="OpenButton"/>
				<TextBox Height="25" Width="300" IsReadOnly="True" x:Name="FileNameBox"/>
			</StackPanel>

			<Border BorderBrush="DarkGray" BorderThickness="1" Height="265" Margin="0,20">
				<TextBlock Background="White" IsEnabled="False" x:Name="ResultsBox"/>
			</Border>

			<Button Width="80" Height="25" Content="Close" Click="CloseButton"/>
		</StackPanel>
    </Grid>
</Window>
